# Third-party tap items are marked `trusted: true` individually rather than
# trusting whole taps, so Homebrew will load just these items.
tap "asmvik/formulae"
tap "jackielii/tap"

# Window management
brew "asmvik/formulae/yabai", trusted: true
cask "jackielii/tap/skhd-zig", trusted: true

# Dev tools
brew "gh"
brew "tig"
brew "pnpm"
brew "pyenv"
brew "pyenv-virtualenv"
brew "xz" # needed by pyenv to build Python's lzma module

# Apps (only those whose vendor lists Homebrew; see README.md for the rest)
cask "klogg"
cask "markdown-preview"
cask "zed"

# Fonts (install.sh copies the rest from shared/fonts/)
cask "font-jetbrains-mono"
